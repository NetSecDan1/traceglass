{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Traceglass: Web UI",
      "type": "process",
      "command": "node",
      "args": ["--env-file-if-exists=.env", "src/cli.js", "serve"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "Traceglass: Demo investigation",
      "type": "process",
      "command": "node",
      "args": ["src/cli.js", "investigate", "--demo", "--user", "alex.morgan@example.com"],
      "problemMatcher": []
    },
    {
      "label": "Traceglass: Tests",
      "type": "process",
      "command": "node",
      "args": ["--test"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Traceglass: Build KQL",
      "type": "process",
      "command": "node",
      "args": ["src/cli.js", "query", "--preset", "user", "--user", "${input:upn}"],
      "problemMatcher": []
    }
  ],
  "inputs": [{ "id": "upn", "type": "promptString", "description": "User principal name" }]
}
